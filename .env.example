# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Бесплатный ключ REST Countries (https://restcountries.com, план Free: 1000 запросов в месяц).
# Без ключа блок «справка о стране» (и зависящий от него курс валюты) вернёт ошибку api_key_missing.
TRIP_RESTCOUNTRIES_API_KEY=

# Nominatim и Overpass требуют User-Agent, по которому с вами можно связаться.
TRIP_USER_AGENT=trip-planner/0.1 (https://github.com/your-name/trip-planner; you@example.com)

# Необязательные настройки (значения по умолчанию показаны)
# TRIP_HTTP_TIMEOUT=5
# TRIP_HTTP_RETRIES=2
# TRIP_RATE_LIMIT_PER_MINUTE=30
# TRIP_LOG_LEVEL=INFO
